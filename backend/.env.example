# ============================================================================
# RESOLVEAI BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================
# Copy this file to .env in the /backend folder.
#
# SECURITY NOTE:
# Never expose SUPABASE_SERVICE_ROLE_KEY, SUPABASE_SECRET_KEY, or GEMINI_API_KEY
# in frontend code or commit real secret keys to Git.
# ============================================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT Authentication Secret
JWT_SECRET=resolveai_super_secret_enterprise_jwt_key_2026_change_in_prod
JWT_EXPIRES_IN=24h

# Supabase PostgreSQL Configuration (Backend Only - Service Role & Secret Keys)
SUPABASE_PROJECT_REF=rdwwbwojqbotvfjbebfb
SUPABASE_URL=https://rdwwbwojqbotvfjbebfb.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.rdwwbwojqbotvfjbebfb.supabase.co:5432/postgres

# Google Gemini API Configuration (Official @google/genai SDK - Backend Only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
