# ============================================================================
# RESOLVEAI — MASTER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================================
# ResolveAI uses separate environment files for Backend and Frontend to ensure
# secret API keys (SUPABASE_SERVICE_ROLE_KEY, SUPABASE_SECRET_KEY, GEMINI_API_KEY,
# JWT_SECRET) are NEVER exposed to browser client code.
#
# 1. Backend configuration: see /backend/.env.example -> copy to /backend/.env
# 2. Frontend configuration: see /frontend/.env.example -> copy to /frontend/.env
# ============================================================================

# --- BACKEND (/backend/.env) ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=resolveai_super_secret_enterprise_jwt_key_2026_change_in_prod
JWT_EXPIRES_IN=24h

# Supabase PostgreSQL (Project Ref: rdwwbwojqbotvfjbebfb)
SUPABASE_PROJECT_REF=rdwwbwojqbotvfjbebfb
SUPABASE_URL=https://rdwwbwojqbotvfjbebfb.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.rdwwbwojqbotvfjbebfb.supabase.co:5432/postgres

# Google Gemini Official @google/genai SDK
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- FRONTEND (/frontend/.env) ---
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SUPABASE_PROJECT_REF=rdwwbwojqbotvfjbebfb
VITE_SUPABASE_URL=https://rdwwbwojqbotvfjbebfb.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
